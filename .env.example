# Hugging Face access token (https://huggingface.co/settings/tokens).
# Required to pull gated/most models. Never commit your real token.
HF_TOKEN=

# Ollama OpenAI-compatible endpoint (default works once `ollama serve` is running).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: override the localforge cache root (models, results).
# Defaults to ~/.cache/localforge
LOCALFORGE_CACHE=
